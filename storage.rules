rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function canAccessKyc(uid) {
      return request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Identity and bank documents are private to the applicant and admins.
    match /vendorApplications/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size <= 1 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg)');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /kyc/{uid}/{fileName} {
      allow read, write: if canAccessKyc(uid);
    }

    // Onboarding files are uploaded and served with short-lived signed URLs
    // issued only by the trusted Functions API.
    match /vendor-onboarding/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      // The application folder is excluded here so this broad rule cannot
      // override the private-document access rules above.
      allow read: if request.auth != null && !allPaths.matches('vendorApplications/.*') && !allPaths.matches('vendor-onboarding/.*');
      allow write: if request.auth != null && !allPaths.matches('vendorApplications/.*') && !allPaths.matches('vendor-onboarding/.*');
    }
  }
}
