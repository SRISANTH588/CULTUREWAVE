[debug] [2026-09-18T12:03:41.919Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ogshootsluxe-36740/rulesets {"name":"projects/ogshootsluxe-36740/rulesets/836e1dc5-6e5a-4d35-86fa-a8e90cba1235","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAdmin() {\n      return request.auth != null &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    // Anyone can write/read their own OTP (needed for signup before auth exists)\n    match /emailOtps/{email} {\n      allow read, write: if true;\n    }\n\n    // Users can read/write their own doc; anyone can create (signup)\n    match /users/{uid} {\n      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());\n      allow create: if true;\n      allow update, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());\n    }\n\n    // Authenticated users can read/write their own data\n    match /events/{id} {\n      allow read: if true;\n      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;\n      allow update, delete: if request.auth != null &&\n        (resource.data.ownerId == request.auth.uid || isAdmin());\n    }\n\n    match /bookings/{id} {\n      allow read: if request.auth != null && (\n        resource.data.userId == request.auth.uid ||\n        resource.data.organiserId == request.auth.uid ||\n        resource.data.ownerId == request.auth.uid || isAdmin()\n        || (resource.data.eventId != null &&\n          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)\n      );\n      allow create: if true;\n      allow update: if true;\n      allow delete: if request.auth != null;\n    }\n\n    match /payments/{id} {\n      allow read: if request.auth != null && (\n        resource.data.userId == request.auth.uid ||\n        resource.data.organiserId == request.auth.uid ||\n        resource.data.ownerId == request.auth.uid || isAdmin()\n        || (resource.data.eventId != null &&\n          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)\n      );\n      allow create: if true;  // allow guest bookings (free + paid) to save\n      allow update, delete: if request.auth != null;\n    }\n\n    match /wallets/{uid} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n\n    match /kyc/{uid} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n\n    match /organisers/{uid} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.uid == uid;\n    }\n\n    match /campaigns/{id} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /webinars/{id} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /restaurants/{id} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    match /clientProjects/{id} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /payouts/{id} {\n      allow read, write: if request.auth != null &&\n        (resource.data.ownerId == request.auth.uid || isAdmin());\n    }\n\n    match /inquiries/{id} {\n      allow read, write: if request.auth != null &&\n        (resource.data.ownerId == request.auth.uid || isAdmin());\n    }\n\n    // Admin-only collections — only authenticated users (admin check done in app)\n    match /adminLogs/{id} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /{document=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-18T12:03:41.918943Z","metadata":{"services":["cloud.firestore"]}}
