[debug] [2026-10-20T17:16:20.494Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ogshootsluxe-36740/rulesets {"name":"projects/ogshootsluxe-36740/rulesets/c8c61e7e-47af-4af0-beea-130fde8c0fa2","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAdmin() {\n      return request.auth != null &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    function isAnonymousApplicant() {\n      return request.auth != null &&\n        request.auth.token.firebase.sign_in_provider == 'anonymous';\n    }\n\n    function validListerActivation(uid, applicationId, tokenHash) {\n      let token = get(/databases/$(database)/documents/onboardingActivationTokens/$(tokenHash)).data;\n      let tokenAfter = getAfter(/databases/$(database)/documents/onboardingActivationTokens/$(tokenHash)).data;\n      let applicationAfter = getAfter(/databases/$(database)/documents/vendorOnboarding/$(applicationId)).data;\n      let userAfter = getAfter(/databases/$(database)/documents/users/$(uid)).data;\n      return request.auth != null && request.auth.uid == uid &&\n        request.auth.token.email_verified == true &&\n        token.applicationId == applicationId &&\n        token.email == request.auth.token.email &&\n        token.used == false && token.expiresAt > request.time &&\n        tokenAfter.used == true && tokenAfter.activatedBy == uid &&\n        applicationAfter.status == 'APPROVED' &&\n        applicationAfter.email == request.auth.token.email &&\n        applicationAfter.activationTokenHash == tokenHash &&\n        applicationAfter.accountSetupStatus == 'ACTIVE' &&\n        applicationAfter.userId == uid &&\n        userAfter.role == 'lister' &&\n        userAfter.onboardingApplicationId == applicationId &&\n        userAfter.activationTokenHash == tokenHash;\n    }\n\n    // Public booking pages may update only the aggregate attendee counter.\n    // Event fields and attendee details remain owner/admin controlled.\n    function attendeeCountIncrement() {\n      let previous = resource.data.get('totalBooked', 0);\n      let next = request.resource.data.get('totalBooked', -1);\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalBooked']) &&\n        (previous is int || previous is float) && next is int &&\n        next > previous && next <= previous + 20 &&\n        resource.data.status in ['published', 'live', 'active'];\n    }\n\n    function validPaidProof(booking, eventId) {\n      let paymentId = booking.get('paymentId', '');\n      let proofPath = /databases/$(database)/documents/verifiedPayments/$(paymentId);\n      let proof = get(proofPath).data;\n      let bookingSeats = booking.get('seatIds', []);\n      let proofSeats = proof.get('seatIds', []);\n      return booking.get('status', '') == 'paid' &&\n        paymentId is string && paymentId.size() > 0 &&\n        proof.status == 'captured' && proof.paymentId == paymentId &&\n        proof.bookingId == booking.get('bookingId', '') &&\n        proof.eventId == eventId && proof.amount == booking.amount * 100 &&\n        proof.tickets == booking.get('seats', -1) &&\n        bookingSeats is list && proofSeats is list &&\n        bookingSeats.size() == proofSeats.size() &&\n        bookingSeats.hasAll(proofSeats) && proofSeats.hasAll(bookingSeats);\n    }\n\n    // Seat selections are written atomically with the corresponding booking.\n    // Public booking pages may append only the seats listed on that booking.\n    function bookedSeatAppend(eventId) {\n      let bookingId = request.resource.data.get('lastSeatBookingId', '');\n      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);\n      let booking = getAfter(bookingPath).data;\n      let oldSeats = resource.data.get('bookedSeats', []);\n      let newSeats = request.resource.data.get('bookedSeats', []);\n      let bookingSeats = booking.get('seatIds', []);\n      return bookingId is string && bookingId.size() > 0 &&\n        existsAfter(bookingPath) &&\n        booking.get('bookingId', '') == bookingId &&\n        booking.get('eventId', '') == eventId &&\n        booking.get('status', '') in ['confirmed', 'paid', 'success', 'completed'] &&\n        bookingSeats is list && bookingSeats.size() > 0 && bookingSeats.size() <= 20 &&\n        ((booking.get('status', '') == 'confirmed' && booking.get('amount', -1) == 0) ||\n          validPaidProof(booking, eventId)) &&\n        oldSeats is list && newSeats is list &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSeats', 'lastSeatBookingId']) &&\n        newSeats.hasAll(oldSeats) &&\n        newSeats.hasAll(bookingSeats) &&\n        newSeats.size() == oldSeats.size() + bookingSeats.size() &&\n        resource.data.status in ['published', 'live', 'active'];\n    }\n\n    function waitlistEventAllows(eventId) {\n      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;\n      return eventData.allowWaitlist == true &&\n        eventData.status in ['published', 'live', 'active'] &&\n        (eventData.get('soldOut', false) == true ||\n          (eventData.overflowAction in ['waitlist', 'notify'] &&\n            eventData.get('capacity', 0) is number &&\n            eventData.get('capacity', 0) > 0 &&\n            eventData.get('totalBooked', 0) >= eventData.get('capacity', 0)));\n    }\n\n    function inviteAllowsBooking(eventId) {\n      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;\n      return eventData.get('inviteOnly', false) != true ||\n        (request.auth != null && exists(/databases/$(database)/documents/eventInviteClaims/$(eventId + '_' + request.auth.uid)));\n    }\n\n    function inviteAllowsWaitlist(eventId) {\n      return inviteAllowsBooking(eventId);\n    }\n\n    function validInviteClaim(eventId) {\n      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;\n      let access = get(/databases/$(database)/documents/eventAccess/$(eventId)).data;\n      let method = request.resource.data.get('method', '');\n      return eventData.get('inviteOnly', false) == true &&\n        request.resource.data.get('eventId', '') == eventId &&\n        request.resource.data.get('userId', '') == request.auth.uid &&\n        ((method == 'email' && request.auth.token.email in access.get('guestEmails', [])) ||\n         (method == 'code' && access.get('inviteCode', '') != '' &&\n          request.resource.data.get('inviteCode', '') == access.get('inviteCode', '')) ||\n         (method == 'link' && access.get('inviteLinkEnabled', false) == true &&\n          access.get('inviteToken', '') != '' &&\n          request.resource.data.get('inviteToken', '') == access.get('inviteToken', '') &&\n          get(/databases/$(database)/documents/eventAccessLinks/$(request.resource.data.get('inviteToken', ''))).data.eventId == eventId));\n    }\n\n    function ownsEvent(eventId) {\n      return request.auth != null &&\n        (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || isAdmin());\n    }\n\n    // Legacy client OTP storage is disabled. New onboarding OTPs are server only.\n    match /emailOtps/{email} {\n      allow read, write: if false;\n    }\n\n    // User documents are self-readable; privileged accounts are server created.\n    match /users/{uid} {\n      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());\n      // Lister/admin accounts are provisioned only by trusted server code.\n      // Preserve ordinary customer sign-up without granting a privileged role.\n      allow create: if (request.auth != null && request.auth.uid == uid &&\n        request.resource.data.role in ['client', 'customer'] &&\n        request.resource.data.status != 'admin') ||\n        (request.resource.data.role == 'lister' &&\n         request.re