rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public booking pages may update only the aggregate attendee counter.
    // Event fields and attendee details remain owner/admin controlled.
    function attendeeCountIncrement() {
      let previous = resource.data.get('totalBooked', 0);
      let next = request.resource.data.get('totalBooked', -1);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalBooked']) &&
        (previous is int || previous is float) && next is int &&
        next > previous && next <= previous + 20 &&
        resource.data.status in ['published', 'live', 'active'];
    }

    function waitlistEventAllows(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      return eventData.allowWaitlist == true &&
        eventData.status in ['published', 'live', 'active'] &&
        (eventData.get('soldOut', false) == true ||
          (eventData.overflowAction in ['waitlist', 'notify'] &&
            eventData.get('capacity', 0) is number &&
            eventData.get('capacity', 0) > 0 &&
            eventData.get('totalBooked', 0) >= eventData.get('capacity', 0)));
    }

    function inviteAllowsBooking(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      return eventData.get('inviteOnly', false) != true ||
        (request.auth != null && exists(/databases/$(database)/documents/eventInviteClaims/$(eventId + '_' + request.auth.uid)));
    }

    function inviteAllowsWaitlist(eventId) {
      return inviteAllowsBooking(eventId);
    }

    function validInviteClaim(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      let access = get(/databases/$(database)/documents/eventAccess/$(eventId)).data;
      let method = request.resource.data.get('method', '');
      return eventData.get('inviteOnly', false) == true &&
        request.resource.data.get('eventId', '') == eventId &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        ((method == 'email' && request.auth.token.email in access.get('guestEmails', [])) ||
         (method == 'code' && access.get('inviteCode', '') != '' &&
          request.resource.data.get('inviteCode', '') == access.get('inviteCode', '')) ||
         (method == 'link' && access.get('inviteLinkEnabled', false) == true &&
          access.get('inviteToken', '') != '' &&
          request.resource.data.get('inviteToken', '') == access.get('inviteToken', '') &&
          get(/databases/$(database)/documents/eventAccessLinks/$(request.resource.data.get('inviteToken', ''))).data.eventId == eventId));
    }

    function ownsEvent(eventId) {
      return request.auth != null &&
        (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || isAdmin());
    }

    // Anyone can write/read their own OTP (needed for signup before auth exists)
    match /emailOtps/{email} {
      allow read, write: if true;
    }

    // Users can read/write their own doc; anyone can create (signup)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if true;
      allow update, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Authenticated users can read/write their own data
    match /events/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if (request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin())) || attendeeCountIncrement();
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /eventAccess/{eventId} {
      allow read, write: if ownsEvent(eventId);
    }

    match /eventAccessLinks/{token} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid &&
        ownsEvent(request.resource.data.eventId);
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid &&
        ownsEvent(resource.data.eventId);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /eventInviteClaims/{claimId} {
      allow create: if request.auth != null && validInviteClaim(request.resource.data.eventId);
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || ownsEvent(resource.data.eventId));
      allow update, delete: if request.auth != null && ownsEvent(resource.data.eventId);
    }

    match /bookings/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.organiserId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid || isAdmin()
        || (resource.data.eventId != null &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)
      );
      allow create: if request.resource.data.eventId is string &&
        inviteAllowsBooking(request.resource.data.eventId);
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Guests can join a waitlist only for an event that has enabled it.
    // Attendees can read their own entry; event owners can manage their entries.
    match /waitlist/{entryId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.eventId is string &&
        waitlistEventAllows(request.resource.data.eventId) &&
        inviteAllowsWaitlist(request.resource.data.eventId) &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.ownerId &&
        request.resource.data.status == 'waiting';
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow update, delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /payments/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.organiserId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid || isAdmin()
        || (resource.data.eventId != null &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)
      );
      allow create: if request.resource.data.eventId is string &&
        inviteAllowsBooking(request.resource.data.eventId);  // guest bookings must pass invite checks when enabled
      allow update, delete: if request.auth != null;
    }

    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /kyc/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /organisers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /playlists/{id} {
      // Saved playlists are guest-facing content; only owners/admins may mutate them.
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.ownerId || isAdmin());
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /campaigns/{id} {
      allow read, write: if request.auth != null;
    }

    match /webinars/{id} {
      allow read, write: if request.auth != null;
    }

    match /restaurants/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clientProjects/{id} {
      allow read, write: if request.auth != null;
    }

    match /payouts/{id} {
      allow read, write: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /inquiries/{id} {
      allow read, write: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /surveys/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /surveyResponses/{id} {
      allow create: if true;
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Admin-only collections — only authenticated users (admin check done in app)
    match /adminLogs/{id} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
