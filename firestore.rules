rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can write/read their own OTP (needed for signup before auth exists)
    match /emailOtps/{email} {
      allow read, write: if true;
    }

    // Users can read/write their own doc; anyone can create (signup)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Authenticated users can read/write their own data
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{id} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if true;  // allow check-in scanner to mark checkedIn
      allow delete: if request.auth != null;
    }

    match /payments/{id} {
      allow read, write: if request.auth != null;
    }

    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /kyc/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /organisers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /campaigns/{id} {
      allow read, write: if request.auth != null;
    }

    match /webinars/{id} {
      allow read, write: if request.auth != null;
    }

    match /restaurants/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clientProjects/{id} {
      allow read, write: if request.auth != null;
    }

    // Admin-only collections — only authenticated users (admin check done in app)
    match /adminLogs/{id} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
