rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public booking pages may update only the aggregate attendee counter.
    // Event fields and attendee details remain owner/admin controlled.
    function attendeeCountIncrement() {
      let previous = resource.data.get('totalBooked', 0);
      let next = request.resource.data.get('totalBooked', -1);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalBooked']) &&
        (previous is int || previous is float) && next is int &&
        next > previous && next <= previous + 20 &&
        resource.data.status in ['published', 'live', 'active'];
    }

    // Anyone can write/read their own OTP (needed for signup before auth exists)
    match /emailOtps/{email} {
      allow read, write: if true;
    }

    // Users can read/write their own doc; anyone can create (signup)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if true;
      allow update, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Authenticated users can read/write their own data
    match /events/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if (request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin())) || attendeeCountIncrement();
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /bookings/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.organiserId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid || isAdmin()
        || (resource.data.eventId != null &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)
      );
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /payments/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.organiserId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid || isAdmin()
        || (resource.data.eventId != null &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.ownerId == request.auth.uid)
      );
      allow create: if true;  // allow guest bookings (free + paid) to save
      allow update, delete: if request.auth != null;
    }

    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /kyc/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /organisers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /playlists/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.ownerId || isAdmin());
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.ownerId || isAdmin());
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /campaigns/{id} {
      allow read, write: if request.auth != null;
    }

    match /webinars/{id} {
      allow read, write: if request.auth != null;
    }

    match /restaurants/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clientProjects/{id} {
      allow read, write: if request.auth != null;
    }

    match /payouts/{id} {
      allow read, write: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /inquiries/{id} {
      allow read, write: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /surveys/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /surveyResponses/{id} {
      allow create: if true;
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Admin-only collections — only authenticated users (admin check done in app)
    match /adminLogs/{id} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
