{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", ".git/**", "**/.git/**", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate"}
        ]
      }
    ],
    "rewrites": [
      { "source": "/event/**", "destination": "/event-detail.html" },
      { "source": "/stall-create", "destination": "/stall-create.html" }
    ]
  }
}
