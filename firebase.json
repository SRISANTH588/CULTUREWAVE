{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", ".git/**", "**/.git/**", "**/node_modules/**"],
    "rewrites": [
      { "source": "/event/**", "destination": "/event-detail.html" }
    ]
  }
}
